# 小语料（<1 小时）用的 MFA 对齐配置。
#
# 仓库原有的 mfa.config 是给粤语大数据集准备的（三音素 2000 leaves /
# 10000 gaussians / 35 轮）。普通话当前只有 588 秒、14 条，参数规模远大于
# 数据量，训练会很慢甚至失败。强制对齐只需要一个"够用"的模型，因此这里
# 把各阶段规模压小。
#
# 用法：
#   mfa train --config_path ./mfa_mandarin_light.config ...

beam: 10
retry_beam: 40

features:
  type: "mfcc"
  use_energy: false
  frame_shift: 10

training:
  - monophone:
      num_iterations: 10
      max_gaussians: 200
      subset: 1000
      boost_silence: 1.25

  - triphone:
      num_iterations: 10
      num_leaves: 200
      max_gaussians: 2000
      cluster_threshold: -1
      subset: 2000
      boost_silence: 1.25
      power: 0.25
