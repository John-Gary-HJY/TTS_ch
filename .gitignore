# ---- Python / 环境 ----
.venv/
.venv*/
__pycache__/
*.py[cod]
.python-version
*.egg-info/

# ---- 大体积原始数据（不入库）----
recordings/
data_local/
preprocessed_data/
preprocessed_data_multi/
preprocessed_data_mandarin/
forced_alignment/speech_corpus/
forced_alignment/speech_corpus_sentences/
forced_alignment/aligned_speech_corpus/
forced_alignment/aligned_sentences/
forced_alignment/acoustic_model.zip
forced_alignment/mandarin_acoustic_model.zip

# ---- 训练产物 / 权重（走 Release asset，不进 git 历史）----
# 目录整体忽略，但 hparams.json 必须入库，否则训练配置无法复现。
# 注意：git 不允许在“父目录已被排除”的情况下直接反选文件，
# 必须先逐级把目录反选回来，再反选 hparams.json。
experiments/**
!experiments/
!experiments/**/
!experiments/**/hparams.json
*.pt
*.pth.tar
*.onnx

# ---- 由 preprocessing 生成的清单（可复现，不入库）----
train_files/train_*.txt
train_files/val_*.txt

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# 注意：forced_alignment/dictionary/ 与 text/canton_dictionary/ 必须保留，
# 文本前端（TextFrontend）在运行时依赖这两个目录。
